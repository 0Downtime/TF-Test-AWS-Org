# Copy this file to azure-devops-pipeline.local.env and keep the copy out of Git.
# The bootstrap script never accepts credentials in this file. Authenticate with
# `az login` and, for Azure DevOps CLI operations, use AZURE_DEVOPS_EXT_PAT only
# in the calling shell if your organization requires a PAT.

AZDO_ORGANIZATION_URL=https://dev.azure.com/replace-me
AZDO_ORGANIZATION_NAME=replace-me
AZDO_ORGANIZATION_GUID=00000000-0000-0000-0000-000000000000
AZDO_PROJECT=replace-me
AZDO_PROJECT_ID=00000000-0000-0000-0000-000000000000
AZDO_PIPELINE_NAME=aws-terraform
AZDO_SERVICE_CONNECTION_NAME=aws-terraform-oidc

# This checkout currently uses GitHub as its origin. Use tfsgit and the Azure
# Repos name instead if the repository is mirrored into Azure Repos.
AZDO_REPOSITORY_TYPE=github
AZDO_REPOSITORY=0Downtime/TF-Test-AWS-Org
AZDO_BRANCH=main
AZDO_PIPELINE_YAML=azure-pipelines.yml

# Required for AWS bootstrap.
AWS_PROFILE=management
AWS_REGION=us-east-1
AWS_MANAGEMENT_ACCOUNT_ID=000000000000
AWS_DEPLOYMENT_ROLE_NAME=AzureDevOpsTerraform

# Required only for `apply-aws`. Start from
# scripts/azuredevops/aws-terraform-deployment-policy.example.json, replace all
# REPLACE_* values, and review it against the saved Terraform plans.
AWS_PERMISSIONS_POLICY_FILE=
AWS_PERMISSIONS_POLICY_NAME=AzureDevOpsTerraformPermissions

# Set this when the GitHub repository is private or Azure DevOps requires a
# GitHub service connection for repository access. Leave blank for a public
# repository when the Azure DevOps CLI can read it without one.
AZDO_REPOSITORY_SERVICE_CONNECTION=

# Optional local directory containing the six files named in the checklist.
# If set, `upload-secure-files` uploads them with pipeline-wide authorization
# disabled. Authorize this pipeline explicitly in the Azure DevOps UI.
AZDO_SECURE_FILES_DIR=

# Optional output directory for generated, non-secret manifests.
BOOTSTRAP_OUTPUT_DIR=.azuredevops-bootstrap
